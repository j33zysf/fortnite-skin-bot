# Copy to .env for local testing:  set -a; source .env; set +a
# In production these are GitHub repo secrets, NOT committed.

# Required to actually post. Get it in Discord: Channel -> Edit Channel ->
# Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Optional. Free key from https://dash.fortnite-api.com (not required for the shop endpoint).
FORTNITE_API_KEY=

# Optional tuning.
NEW_DAYS=2
MAX_SKINS=10
